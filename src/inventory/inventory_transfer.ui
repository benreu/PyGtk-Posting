<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkAdjustment" id="transfer_qty_adjustment">
    <property name="lower">1</property>
    <property name="upper">1000000</property>
    <property name="value">1</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkListStore" id="transfer_location_store">
    <columns>
      <!-- column-name id -->
      <column type="gchararray"/>
      <!-- column-name location_name -->
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkListStore" id="transfer_product_store">
    <columns>
      <!-- column-name product_id -->
      <column type="gchararray"/>
      <!-- column-name product_name -->
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkListStore" id="transfer_lines_store">
    <columns>
      <!-- column-name product_id -->
      <column type="gint64"/>
      <!-- column-name qty -->
      <column type="gint"/>
      <!-- column-name product_name -->
      <column type="gchararray"/>
      <!-- column-name on_hand_at_source -->
      <column type="gint"/>
    </columns>
  </object>
  <object class="GtkEntryCompletion" id="transfer_product_completion">
    <property name="model">transfer_product_store</property>
    <property name="text-column">1</property>
    <property name="inline-completion">True</property>
    <signal name="match-selected" handler="transfer_product_match_selected" swapped="no"/>
    <child>
      <object class="GtkCellRendererText"/>
      <attributes>
        <attribute name="text">1</attribute>
      </attributes>
    </child>
  </object>
  <object class="GtkMenu" id="transfer_right_click_menu">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <child>
      <object class="GtkMenuItem" id="transfer_remove_menuitem">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="label" translatable="yes">Remove line</property>
        <property name="use-underline">True</property>
        <signal name="activate" handler="transfer_remove_activated" swapped="no"/>
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="transfer_product_hub_menuitem">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="label" translatable="yes">Product hub</property>
        <property name="use-underline">True</property>
        <signal name="activate" handler="transfer_product_hub_activated" swapped="no"/>
      </object>
    </child>
  </object>
  <object class="GtkWindow" id="transfer_window">
    <property name="can-focus">False</property>
    <property name="title" translatable="yes">Transfer Inventory</property>
    <property name="window-position">center</property>
    <property name="default-width">720</property>
    <property name="default-height">520</property>
    <signal name="focus-in-event" handler="transfer_focus_in" swapped="no"/>
    <child>
      <object class="GtkBox" id="transfer_outer_box">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="border-width">10</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkGrid" id="transfer_location_grid">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="row-spacing">6</property>
            <property name="column-spacing">8</property>
            <child>
              <object class="GtkLabel" id="transfer_source_title">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Move from</property>
                <property name="xalign">1</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkComboBox" id="transfer_source_combo">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="hexpand">True</property>
                <property name="model">transfer_location_store</property>
                <property name="id-column">0</property>
                <signal name="changed" handler="transfer_source_changed" swapped="no"/>
                <child>
                  <object class="GtkCellRendererText" id="transfer_source_renderer"/>
                  <attributes>
                    <attribute name="text">1</attribute>
                  </attributes>
                </child>
              </object>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="transfer_destination_title">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Move to</property>
                <property name="xalign">1</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkComboBox" id="transfer_destination_combo">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="hexpand">True</property>
                <property name="model">transfer_location_store</property>
                <property name="id-column">0</property>
                <signal name="changed" handler="transfer_destination_changed" swapped="no"/>
                <child>
                  <object class="GtkCellRendererText" id="transfer_destination_renderer"/>
                  <attributes>
                    <attribute name="text">1</attribute>
                  </attributes>
                </child>
              </object>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="transfer_locations_button">
                <property name="label" translatable="yes">Locations</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <signal name="clicked" handler="transfer_locations_clicked" swapped="no"/>
              </object>
              <packing>
                <property name="left-attach">2</property>
                <property name="top-attach">0</property>
                <property name="height">2</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkSeparator" id="transfer_upper_separator">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="transfer_picker_box">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkComboBox" id="transfer_product_combo">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="hexpand">True</property>
                <property name="model">transfer_product_store</property>
                <property name="has-entry">True</property>
                <property name="entry-text-column">1</property>
                <property name="id-column">0</property>
                <signal name="changed" handler="transfer_product_combo_changed" swapped="no"/>
                <child internal-child="entry">
                  <object class="GtkEntry" id="transfer_product_entry">
                    <property name="can-focus">True</property>
                    <property name="completion">transfer_product_completion</property>
                    <property name="placeholder-text" translatable="yes">Search product</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="transfer_on_hand_label">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">no product</property>
                <property name="width-chars">22</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="transfer_qty_spinbutton">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="max-length">9</property>
                <property name="width-chars">8</property>
                <property name="adjustment">transfer_qty_adjustment</property>
                <property name="numeric">True</property>
                <property name="value">1</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">2</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="transfer_add_button">
                <property name="label" translatable="yes">Add</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <signal name="clicked" handler="transfer_add_clicked" swapped="no"/>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">3</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">2</property>
          </packing>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="transfer_lines_scroller">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="shadow-type">in</property>
            <child>
              <object class="GtkTreeView" id="transfer_lines_treeview">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="model">transfer_lines_store</property>
                <signal name="button-release-event" handler="transfer_treeview_button_release_event" swapped="no"/>
                <child internal-child="selection">
                  <object class="GtkTreeSelection" id="transfer_lines_selection"/>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="transfer_product_column">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Product</property>
                    <property name="expand">True</property>
                    <child>
                      <object class="GtkCellRendererText" id="transfer_product_cell"/>
                      <attributes>
                        <attribute name="text">2</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="transfer_qty_column">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Quantity</property>
                    <child>
                      <object class="GtkCellRendererSpin" id="transfer_qty_cell">
                        <property name="editable">True</property>
                        <property name="adjustment">transfer_qty_adjustment</property>
                        <signal name="edited" handler="transfer_qty_edited" swapped="no"/>
                      </object>
                      <attributes>
                        <attribute name="text">1</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="transfer_on_hand_column">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">On hand at source</property>
                    <child>
                      <object class="GtkCellRendererText" id="transfer_on_hand_cell"/>
                      <attributes>
                        <attribute name="text">3</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">3</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="transfer_notes_box">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel" id="transfer_notes_title">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Notes</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkEntry" id="transfer_notes_entry">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hexpand">True</property>
                <property name="placeholder-text" translatable="yes">why the stock is moving</property>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">4</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="transfer_action_box">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel" id="transfer_status_label">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="hexpand">True</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="transfer_post_button">
                <property name="label" translatable="yes">Transfer</property>
                <property name="visible">True</property>
                <property name="sensitive">False</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <signal name="clicked" handler="transfer_post_clicked" swapped="no"/>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">5</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
